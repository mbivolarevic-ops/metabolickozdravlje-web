# .env.example — samo nazivi promenljivih, NIKADA stvarne vrednosti.
# Stvarne vrednosti žive isključivo u okruženju (lokalni .env, hosting panel),
# nikada u repozitorijumu. Videti docs/01, sekcija 15.4 i CLAUDE.md, sekcija 9.
#
# Napomena (Sprint 1): nijedna od ovih promenljivih se još ne koristi u kodu.
# Lista prati docs/01 §15.4 i popunjavaće se u narednim sprintovima.

# Sanity Studio (lokalno pokretanje). Project ID nije tajna, ali se stvarna
# vrednost drži u .env.local, koji Git ignoriše. Dataset se NE zadaje ovde —
# svaki workspace ima svoj dataset upisan u sanity.config.ts, da se Studio ne
# bi promenljivom slučajno prebacio na pogrešan dataset.
SANITY_STUDIO_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
TRANSACTIONAL_EMAIL_API_KEY=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
GUIDE_DOWNLOAD_SIGNING_SECRET=
RATE_LIMIT_SECRET=
